{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tilden.example/schema/tilden-resolution-request-v0.1.schema.json",
  "title": "Tilden Resolution Request v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "identifier"],
  "properties": {
    "version": {"const": "0.1"},
    "identifier": {
      "type": "string",
      "minLength": 1
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "media": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "protocols": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "features": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
