{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tilden.example/spec/0.1/tilden-resolution.schema.json",
  "title": "TildenResolution",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "canonicalIdentity",
    "authority",
    "endpoints",
    "capabilities",
    "trust",
    "expiresAt"
  ],
  "properties": {
    "version": {
      "const": "0.1"
    },
    "canonicalIdentity": {
      "type": "string",
      "minLength": 1
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "delegatedBy": { "type": "string", "minLength": 1 }
      }
    },
    "endpoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["uri"],
        "properties": {
          "uri": { "type": "string", "minLength": 1 },
          "priority": { "type": "integer", "minimum": 0, "default": 0 },
          "weight": { "type": "integer", "minimum": 0, "default": 0 },
          "transport": { "type": "string", "minLength": 1 },
          "capabilities": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/capability" }
          },
          "security": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/capability" }
    },
    "trust": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile"],
      "properties": {
        "profile": { "type": "string", "minLength": 1 },
        "keyId": { "type": "string", "minLength": 1 },
        "proof": { "type": "string", "minLength": 1 },
        "reference": { "type": "string", "minLength": 1 }
      }
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "parameters": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}
